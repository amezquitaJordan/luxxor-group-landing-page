# Groq — chat (Sesión 7). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
GROQ_API_KEY=

# Upstash Redis — rate limit distribuido del chat (Sesión 7).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Orígenes extra permitidos para /api/chat, separados por coma (p. ej., http://localhost:3100 con next start).
ORIGENES_PERMITIDOS=

# Carpeta con fotos originales y PDF, fuera del repo (scripts/optimizar-fotos.mjs, Sesión 4).
# Ejemplo: RUTA_RECURSOS=C:\Luxxor\recursos
RUTA_RECURSOS=
